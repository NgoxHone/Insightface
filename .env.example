# Face Recognition API Configuration
# Copy this file to .env and adjust values

# API settings
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=False
API_THREADS=4
API_MAX_CONTENT_LENGTH=52428800  # 50MB

# Frontend settings
FRONTEND_PORT=3000

# Detection
DETECTION_THRESHOLD=0.5
MIN_FACE_SIZE=20
MAX_FACES_PER_IMAGE=50

# Recognition
RECOGNITION_THRESHOLD=0.6
MAX_EMBEDDINGS_PER_PERSON=20
USE_AVERAGE_EMBEDDING=true

# Quality checking
ENABLE_QUALITY_CHECK=true
MIN_IMAGE_QUALITY_SCORE=0.5
BLUR_THRESHOLD=100.0

# Alignment
ENABLE_ALIGNMENT=true

# Training
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=50
TRAIN_LEARNING_RATE=0.001

# Logging
LOG_LEVEL=INFO
